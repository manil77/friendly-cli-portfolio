# Copy to .env.local for local dev (`npm run dev`). On Vercel, set these in Project → Settings → Environment Variables.

# Postgres (added automatically when you connect Neon from the Vercel Storage tab).
# Leave empty locally to use an embedded database in .data/
DATABASE_URL=

# Admin login for /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`)
ADMIN_SECRET=

# Public site URL, used for tracked links and alert emails
SITE_URL=https://your-site.vercel.app

# Company lookup (free token from https://ipinfo.io/signup) — optional
IPINFO_TOKEN=

# Email alerts via Resend (https://resend.com) — optional
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Must be a sender on a domain verified in Resend; onboarding@resend.dev only delivers to your own Resend account email
ALERT_EMAIL_FROM=Portfolio <onboarding@resend.dev>

# Image/résumé uploads (added automatically when you connect Vercel Blob). Locally, uploads go to public/uploads/
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron (Vercel sends it automatically when set)
CRON_SECRET=
